{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strata",
  "version": "0.2.0",
  "identifier": "de.jstut.strata",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Strata",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENjdBNjQ3M0NBMzM3NUUKUldSZU42TThSNlpuSFl5bnNmdzQ4dHBoMUlPa2ZTZnNoZGU2dzdMMFhSbUVjTkRwN0VQK28xUjYK",
      "endpoints": [
        "https://github.com/manusmd/strata/releases/latest/download/latest.json"
      ]
    }
  }
}
